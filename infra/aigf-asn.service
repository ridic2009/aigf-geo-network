[Unit]
Description=AIGF network: fetch who announces which addresses, to tell data centres from readers
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
StateDirectory=aigf-asn
StateDirectoryMode=0755
# iptoasn.com's table, public domain, a few megabytes. A broken download never
# replaces a good table: the counter keeps reading the last one.
ExecStart=/bin/sh -c 'curl -fsSL --max-time 300 -o /var/lib/aigf-asn/.new.gz https://iptoasn.com/data/ip2asn-combined.tsv.gz && gzip -t /var/lib/aigf-asn/.new.gz && chmod 644 /var/lib/aigf-asn/.new.gz && mv /var/lib/aigf-asn/.new.gz /var/lib/aigf-asn/ip2asn-combined.tsv.gz'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Nice=10
TimeoutStartSec=600
