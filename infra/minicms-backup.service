[Unit]
Description=MiniCMS off-site backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/aigf-network
EnvironmentFile=/etc/minicms.env
ExecStart=/usr/bin/php /srv/aigf-network/scripts/backup.php push
TimeoutStartSec=60min
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/aigf-network

# The backup host needs BACKUP_HOST/BACKUP_USER in the environment file and an
# SSH key plus known_hosts for this account. The encryption key lives in
# /srv/aigf-network/.secrets/backup.key — keep a copy of it off both servers.
