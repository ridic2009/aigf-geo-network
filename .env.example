# Copy to .env for deploying by hand from a workstation.
# In CI these live in GitHub Secrets instead — never commit the real .env.

# One or more servers, comma or space separated.
# The first one is the default target for ./scripts/dns apply.
DEPLOY_HOSTS=203.0.113.10

# SSH user created by infra/server-setup.sh
DEPLOY_USER=deploy
DEPLOY_PORT=22

# Web root on the server
DEPLOY_ROOT=/srv/www

# How many previous releases to keep per site (rollback depth)
KEEP_RELEASES=5

# Cloudflare API token with Zone:Read + DNS:Edit, used by ./scripts/dns
# CLOUDFLARE_API_TOKEN=
