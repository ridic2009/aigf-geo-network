# Shell scripts and server configuration run on Linux: they must keep LF endings
# even when the repository is cloned on Windows. A CRLF in server-setup.sh or in
# a deploy script breaks it with a confusing "bad interpreter" error.
* text=auto eol=lf

*.sh            text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.twig          text eol=lf
*.md            text eol=lf
*.php           text eol=lf
*.css           text eol=lf
*.js            text eol=lf

# Wrappers without an extension
scripts/build       text eol=lf
scripts/build-all   text eol=lf
scripts/cms-config  text eol=lf
scripts/deploy      text eol=lf
scripts/deploy-all  text eol=lf
scripts/dev         text eol=lf
scripts/dns         text eol=lf
scripts/new-geo     text eol=lf
scripts/nginx-config    text eol=lf
scripts/prepare     text eol=lf
scripts/redirect-config text eol=lf
scripts/rollback    text eol=lf
scripts/smoke       text eol=lf
scripts/validate    text eol=lf

# Windows wrappers keep CRLF
*.cmd           text eol=crlf

# Binary
*.png binary
*.jpg binary
*.webp binary
*.avif binary
*.ico binary
