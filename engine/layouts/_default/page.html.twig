{# Static page: about, privacy, affiliate disclosure, … #}
{% extends '_default/base.html.twig' %}

{% block main %}
<article class="article">
    <div class="container container--narrow">
        <header class="article__header">
            <h1 class="article__title">{{ page.title }}</h1>
            {%- if page.intro|default(null) %}
            <div class="article__intro">{{ page.intro|markdown_to_html|raw }}</div>
            {%- endif %}
            <div class="article__meta">
                {% include 'components/last-updated.twig' with { 'date': page.date, 'updated': page.updated|default(null) } %}
            </div>
        </header>

        <div class="article__body prose">{{ page.content|raw }}</div>

        {% include 'components/faq.twig' with { 'items': page.faq|default([]) } %}
    </div>
</article>
{% endblock %}
