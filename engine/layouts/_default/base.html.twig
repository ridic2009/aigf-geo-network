{#
  BASE LAYOUT - the single HTML skeleton of the whole network.
  Every GEO site renders through this file; nothing here is GEO specific.

  Variables defined here are available inside the {% block %}s of child layouts:
    geo       GEO identity (code, hreflang, currency…)      <- config/geos/<geo>.yml
    ui / L    localized interface strings / labels shortcut <- config/geos/<geo>.yml
    products  products already merged with their GEO overrides
    crumbs    breadcrumb trail, rendered visually AND as BreadcrumbList JSON-LD
#}
{%- set geo = site.geo -%}
{%- set ui = site.ui -%}
{%- set L = ui.labels -%}

{#- products: global defaults + GEO overrides, resolved once per page -#}
{%- set products = {} -%}
{%- for pid, p in site.data.products|default({}) -%}
    {%- set products = products|merge({ (pid): p|merge(p.geo[geo.code]|default({}))|merge({'id': pid}) }) -%}
{%- endfor -%}

{#- breadcrumbs: built from the routing hierarchy, never stored in content.
    `path` is the relative link used visually, `url` the absolute one used by JSON-LD. -#}
{%- set crumbs = [{ 'title': L.home, 'path': '/', 'url': site.baseurl, 'current': false }] -%}
{%- if page.type|default('page') != 'homepage' -%}
    {%- set sec = page.section|default(null) -%}
    {%- if sec and page.id != sec and site.pages.has(sec) and site.pages.get(sec).published -%}
        {%- set sp = site.pages.get(sec) -%}
        {%- set crumbs = crumbs|merge([{ 'title': sp.title, 'path': url(sp, {canonical: false}), 'url': url(sp, {canonical: true}), 'current': false }]) -%}
    {%- endif -%}
    {%- set crumbs = crumbs|merge([{ 'title': page.breadcrumb_title|default(page.title), 'path': url(page, {canonical: false}), 'url': url(page, {canonical: true}), 'current': true }]) -%}
{%- endif -%}

{#- Site search: a page generated by the engine (config/common.yml -> pages.default)
    plus a JSON index main.js downloads the first time someone searches. The
    version parameter keeps a browser from searching last week's index. -#}
{%- set search_url = site.pages.has('search') ? url(site.pages.get('search'), {canonical: false}) : null -%}
{%- set search_index = site.pages.has('search-index') ? url(site.pages.get('search-index'), {canonical: false}) ~ '?v=' ~ 'now'|date('YmdHi') : null -%}
<!DOCTYPE html>
<html lang="{{ geo.hreflang }}">
<head>
{% include 'partials/head.html.twig' %}
</head>
<body class="page page--{{ page.type|default('page') }}">
<a class="skip-link" href="#main">{{ L.skip_to_content }}</a>

{% include 'components/header.twig' %}

<main id="main" class="main">
    {% if crumbs|length > 1 %}
        {% include 'components/breadcrumbs.twig' with { 'items': crumbs } %}
    {% endif %}

    {% block main %}{% endblock %}
    {% set model_fields = site.page_types[page.type|default('static')].fields|default({}) %}
    {% if model_fields|filter(f => f.display|default(false))|length %}
    <div class="container container--narrow"><dl class="model-details">
    {% for key, field in model_fields %}
        {% if field.display|default(false) and attribute(page, key)|default(null) is not null %}
        <dt>{{ field.label|default(key) }}</dt><dd>{% if field.type == 'date' %}{{ attribute(page, key)|date('Y-m-d') }}{% else %}{{ attribute(page, key) }}{% endif %}</dd>
        {% endif %}
    {% endfor %}
    </dl></div>
    {% endif %}
    {% if page.blocks|default([])|length %}
    <div class="container content-blocks">
        {% for block in page.blocks %}
            {% set definition = site.block_types[block.type]|default(null) %}
            {% if definition %}{% include definition.template ~ '.html.twig' with {'block': block} %}{% endif %}
        {% endfor %}
    </div>
    {% endif %}
</main>

{% include 'components/footer.twig' %}

{#- Shown by main.js once the reader is a couple of screens down. "#top" scrolls
    to the top of the document by definition, so it also works without it. -#}
<a class="to-top" href="#top" data-to-top hidden>
    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    <span class="visually-hidden">{{ L.back_to_top }}</span>
</a>

<script src="{{ url(asset('js/main.js')|minify, {canonical: false}) }}" defer></script>
</body>
</html>
