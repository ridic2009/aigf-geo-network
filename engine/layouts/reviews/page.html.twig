{# Review page: one product, editorial verdict, pros/cons, CTA. #}
{% extends '_default/article.html.twig' %}

{% block hero %}
    {%- set product = page.product is defined ? products[page.product]|default(null) : null -%}
    {%- if product %}
        {% include 'components/product-hero.twig' with { 'product': product } %}
    {%- endif %}
{% endblock %}

{# The review hero discloses the relationship beside its first CTA. #}
{% block disclosure %}{% endblock %}

{% block lead %}

    {%- if page.verdict|default(null) %}
    <section class="verdict">
        <h2 class="verdict__title">{{ site.ui.labels.verdict }}</h2>
        <div class="verdict__body prose">{{ page.verdict|markdown_to_html|raw }}</div>
    </section>
    {%- endif %}

    {% include 'components/pros-cons.twig' with { 'pros': page.pros|default([]), 'cons': page.cons|default([]) } %}
{% endblock %}

{% block after_body %}
    {%- set product = page.product is defined ? products[page.product]|default(null) : null -%}
    {%- if product %}
        {% include 'components/cta.twig' with { 'product': product } %}
    {%- endif %}
{% endblock %}

{#- The end of a review sends the reader on: to the apps most like this one
    (reviews the editor linked in `related:` count as picks), then to the
    articles and comparisons that talk about this app. -#}
{% block after_faq %}
    {%- set product = page.product is defined ? products[page.product]|default(null) : null -%}
    {%- if product %}
        {%- set linked = [] -%}
        {%- for id in page.related|default([]) -%}
            {%- if site.pages.has(id) and site.pages.get(id).type|default('') == 'review' -%}
                {%- set linked = linked|merge([site.pages.get(id).product]) -%}
            {%- endif -%}
        {%- endfor -%}
        {% include 'components/similar-apps.twig' with { 'product': product, 'ids': page.similar|default(linked) } %}
    {%- endif %}
{% endblock %}

{% block related %}
    {%- set explicit = page.related|default([])|filter(id => site.pages.has(id) and site.pages.get(id).type|default('') != 'review') -%}
    {%- set mentions = site.pages.showable|filter(p => p.type|default('') in ['comparison', 'guide', 'article'] and page.product|default('') in p.products|default([]))|sort_by_date|map(p => p.id) -%}
    {% include 'components/related-content.twig' with { 'ids': explicit|merge(mentions), 'section': null, 'limit': 4 } %}
{% endblock %}
