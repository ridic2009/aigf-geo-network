{#
  AFFILIATE ABSTRACTION LAYER
  ---------------------------
  Templates never read data/affiliates/*.yml directly. They call:

      {% import 'helpers/affiliate.twig' as aff %}
      {{ aff.url(site, 'candy-ai', site.geo.code) }}

  Two modes, switched by `affiliate.redirect_base` in config/common.yml:

    empty  -> the network URL is written straight into the HTML
    set    -> links point at go.<domain>/<product>/<geo>, and the destination
              lives in an Nginx map generated by scripts/redirect-config.
              Changing a partner link then no longer requires rebuilding pages.

  Either way the product still needs an entry in data/affiliates/: a product
  with no affiliate destination falls back to its official website.
#}

{# The destination configured for this product/GEO (empty when there is none). #}
{% macro destination(site, product_id, geo) %}
{%- set entry = site.data.affiliates[product_id]|default(null) -%}
{%- if entry -%}
{{- entry.geo[geo].url|default(entry.default|default('')) -}}
{%- endif -%}
{% endmacro %}

{# The URL to put in href: either the redirect service or the destination. #}
{% macro url(site, product_id, geo) %}
{%- import _self as aff -%}
{%- set destination = aff.destination(site, product_id, geo)|trim -%}
{%- if destination is empty -%}
{%- else -%}
{%- set redirect_base = site.affiliate.redirect_base|default('') -%}
{%- if redirect_base is not empty -%}
{{- redirect_base|trim('/') ~ '/' ~ product_id ~ '/' ~ geo -}}
{%- else -%}
{{- destination -}}
{%- endif -%}
{%- endif -%}
{% endmacro %}

{# Is there a usable affiliate destination for this product/GEO? #}
{% macro has(site, product_id, geo) %}
{%- import _self as aff -%}
{{- aff.destination(site, product_id, geo)|trim is not empty ? '1' : '' -}}
{% endmacro %}

{# rel attribute required for monetised outbound links #}
{% macro rel(site) %}{{- site.affiliate.rel|default('sponsored nofollow noopener') -}}{% endmacro %}

{% macro target(site) %}{{- site.affiliate.target|default('_blank') -}}{% endmacro %}
